Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"aval", "=", ".5"}], ";", 
  RowBox[{"e1", "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      SqrtBox["3"], "2"], ",", 
     FractionBox["1", "2"]}], "}"}]}], ";", 
  RowBox[{"e2", "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      SqrtBox["3"], "2"], ",", 
     RowBox[{"-", 
      FractionBox["1", "2"]}]}], "}"}]}], ";", 
  RowBox[{"p0", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"Re", "[", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"Sin", "[", "qx", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "qy", "]"}], "2"], "-", 
        SuperscriptBox["aval", "2"]}]], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"qx", ",", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"4", "\[Pi]"}], "3"]}], ",", 
       FractionBox[
        RowBox[{"4", "\[Pi]"}], "3"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"qy", ",", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], 
         SqrtBox["3"]]}], ",", 
       FractionBox[
        RowBox[{"2", "\[Pi]"}], 
        SqrtBox["3"]]}], "}"}], ",", 
     RowBox[{"RegionFunction", "\[Rule]", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"qx", ",", "qy", ",", "z"}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{"2", "\[Pi]"}], 
            SqrtBox["3"]]}], "<", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"qx", ",", "qy"}], "}"}], ".", "e1"}], "<", 
          FractionBox[
           RowBox[{"2", "\[Pi]"}], 
           SqrtBox["3"]]}], "&&", 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{"2", "\[Pi]"}], 
            SqrtBox["3"]]}], "<", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"qx", ",", "qy"}], "}"}], ".", "e2"}], "<", 
          FractionBox[
           RowBox[{"2", "\[Pi]"}], 
           SqrtBox["3"]]}]}]}], "]"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"FontSize", "\[Rule]", "18"}], ",", 
          RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", "Bold", ",", 
          " ", "Gray"}], "]"}]}], ","}], "*)"}], 
     RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
     RowBox[{"MaxRecursion", "->", "1"}], ",", 
     RowBox[{"Frame", "\[Rule]", "None"}], ",", 
     RowBox[{"ContourStyle", "\[Rule]", "Dashed"}], ",", 
