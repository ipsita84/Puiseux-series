Cell[BoxData[{
 RowBox[{
  RowBox[{"$PrePrint", "=", 
   RowBox[{
    RowBox[{"#", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Csc", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Sin", "[", "z", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Sec", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Cos", "[", "z", "]"}]}]}]}]}], "}"}]}], "&"}]}], ";", 
  RowBox[{"rep", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kx", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"ky", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"kp", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ",", 
     RowBox[{"kz", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ass", "=", 
   RowBox[{"Assumptions", "->", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Epsilon]", ",", "kx", ",", "ky", ",", "kz", ",", "\[Alpha]", ",", 
        "\[Theta]", ",", "d"}], "}"}], "\[Element]", " ", "Reals"}], "  ", "&&",
      " ", 
     RowBox[{"\[Epsilon]", ">", "0"}]}]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"repl", "=", 
