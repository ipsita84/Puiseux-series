              RowBox[{"en", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", "0"}],
         "]"}]}]}], "/.", "rep"}]}], ";"}], "\[IndentingNewLine]", 
