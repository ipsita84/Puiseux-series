         RowBox[{"\[Psi]2", ",", "ky"}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"A2z", "=", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"\[Psi]2dag", ".", 
        RowBox[{"D", "[", 
         RowBox[{"\[Psi]2", ",", "kz"}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"om2x", "=", 
      RowBox[{"(", 
