                RowBox[{"dery", ".", 
                 RowBox[{"vec", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], ")"}]}]}], ")"}],
           "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"vecdag", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ".", 
              RowBox[{"vec", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"vecdag", "[", 
