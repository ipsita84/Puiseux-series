  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"ham", ",", "hamt"}], "]"}], ";", 
    RowBox[{"cmat", "=", 
     TagBox[
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {"0", "0", "1"},
         {"0", 
          RowBox[{"-", "1"}], "0"},
         {"1", "0", "0"}
        },
        GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.7]}, 
            Offset[0.27999999999999997`]}, "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}}], "\[NoBreak]", ")"}],
      Function[BoxForm`e$, 
       MatrixForm[BoxForm`e$]]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ham", "[", 
      RowBox[{"kx_", ",", "ky_", ",", "kz_", ",", "a_"}], "]"}], "=", 
     TagBox[
      TagBox[
       RowBox[{"(", "\[NoBreak]", GridBox[{
          {
           RowBox[{"kz", "+", 
            RowBox[{"\[ImaginaryI]", " ", "a", " "}]}], 
           FractionBox[
            RowBox[{"kx", "-", 
             RowBox[{"\[ImaginaryI]", " ", "ky"}]}], 
            SqrtBox["2"]], "0"},
          {
           FractionBox[
            RowBox[{"kx", "+", 
             RowBox[{"\[ImaginaryI]", " ", "ky"}]}], 
            SqrtBox["2"]], "0", 
           FractionBox[
            RowBox[{"kx", "-", 
             RowBox[{"\[ImaginaryI]", " ", "ky"}]}], 
            SqrtBox["2"]]},
          {"0", 
           FractionBox[
            RowBox[{"kx", "+", 
             RowBox[{"\[ImaginaryI]", " ", "ky"}]}], 
            SqrtBox["2"]], 
           RowBox[{
            RowBox[{"-", "kz"}], "-", 
            RowBox[{"\[ImaginaryI]", " ", "a", " "}]}]}
         },
         GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
         GridBoxSpacings->{"Columns" -> {
             Offset[0.27999999999999997`], {
              Offset[0.7]}, 
