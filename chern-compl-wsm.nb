  RowBox[{
   RowBox[{
    RowBox[{"A1x", "=", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"\[Psi]1dag", ".", 
       RowBox[{"D", "[", 
        RowBox[{"\[Psi]1", ",", "kx"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A1y", "=", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"\[Psi]1dag", ".", 
       RowBox[{"D", "[", 
        RowBox[{"\[Psi]1", ",", "ky"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A1z", "=", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"\[Psi]1dag", ".", 
       RowBox[{"D", "[", 
        RowBox[{"\[Psi]1", ",", "kz"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"om1x", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"A1z", ",", "ky"}], "]"}], "-", 
          RowBox[{"D", "[", 
           RowBox[{"A1y", ",", "kz"}], "]"}]}], ")"}], "/.", "rep"}], ",", 
       "ass"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"om1y", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"A1x", ",", "kz"}], "]"}], "-", 
          RowBox[{"D", "[", 
           RowBox[{"A1z", ",", "kx"}], "]"}]}], ")"}], "/.", "rep"}], ",", 
       "ass"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"om1z", "=", 
     RowBox[{"Simplify", "[", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"A1y", ",", "kx"}], "]"}], "-", 
          RowBox[{"D", "[", 
           RowBox[{"A1x", ",", "ky"}], "]"}]}], ")"}], "/.", "rep"}], ",", 
       "ass"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"om1x", ",", "om1y", ",", " ", "om1z"}], "}"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"Om1dotdS", ",", "k"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Om1dotdS", "[", 
     RowBox[{"a_", ",", "b_", ",", "k_", ",", "\[Theta]_", ",", "\[Phi]_"}], 
     "]"}], "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"om1x", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "+", 
          RowBox[{"om1y", " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
          RowBox[{"om1z", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], 
        SuperscriptBox["k", "2"], 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "/.", "rep"}], ",", "ass"}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Om1dotdS", "[", 
     RowBox[{"2.0", ",", "1", ",", "1", ",", "0.1", ",", "1"}], "]"}], "//", 
