Cell[BoxData[{
 RowBox[{
  RowBox[{"p01", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"Sin", "[", "qx", "]"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "qy", "]"}], "2"]}], "==", 
      SuperscriptBox["aval", "2"]}], ",", 
     RowBox[{"{", 
      RowBox[{"qx", ",", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"4", "\[Pi]"}], "3"]}], ",", 
       FractionBox[
        RowBox[{"4", "\[Pi]"}], "3"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"qy", ",", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"2", "\[Pi]"}], 
         SqrtBox["3"]]}], ",", 
       FractionBox[
        RowBox[{"2", "\[Pi]"}], 
        SqrtBox["3"]]}], "}"}], ",", 
     RowBox[{"RegionFunction", "\[Rule]", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"qx", ",", "qy", ",", "z"}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{"2", "\[Pi]"}], 
            SqrtBox["3"]]}], "<", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"qx", ",", "qy"}], "}"}], ".", "e1"}], "<", 
          FractionBox[
           RowBox[{"2", "\[Pi]"}], 
           SqrtBox["3"]]}], "&&", 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{"2", "\[Pi]"}], 
            SqrtBox["3"]]}], "<", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"qx", ",", "qy"}], "}"}], ".", "e2"}], "<", 
          FractionBox[
           RowBox[{"2", "\[Pi]"}], 
           SqrtBox["3"]]}]}]}], "]"}]}], ",", " ", 
     RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
     RowBox[{"ContourStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       RowBox[{"White", ",", 
        RowBox[{"Dashing", "[", "0.006", "]"}], ",", 
        RowBox[{"Thickness", "[", "0.007", "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
