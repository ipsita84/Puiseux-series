Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"ham", ",", "en", ",", "fn1", ",", "fn2"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ham", "[", 
    RowBox[{"kx_", ",", "ky_"}], "]"}], "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       RowBox[{"-", "\[Epsilon]"}], 
       RowBox[{"kx", "+", "\[Epsilon]"}], 
       RowBox[{"\[Epsilon]", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}]}]},
      {
       RowBox[{"kx", "-", "\[Epsilon]"}], "0", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ky", "-", "\[Epsilon]"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}]}]},
      {
       RowBox[{
        RowBox[{"-", "\[Epsilon]"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", "\[ImaginaryI]"}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ky", "+", "\[Epsilon]"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", "\[ImaginaryI]"}], ")"}]}], "\[Epsilon]"}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], ")"}]}], ";", 
  RowBox[{"lim", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"det", "[", 
    RowBox[{"kx_", ",", "ky_", ",", "\[Epsilon]_"}], "]"}], "=", 
   RowBox[{"-", 
    RowBox[{"Det", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"ham", "[", 
         RowBox[{"kx_", ",", "ky_", ",", "\[Epsilon]_"}], "]"}], "=", 
        RowBox[{"(", "\[NoBreak]", GridBox[{
           {
            RowBox[{"-", "\[Epsilon]"}], 
            RowBox[{"kx", "+", "\[Epsilon]"}], 
            RowBox[{"\[Epsilon]", 
             RowBox[{"(", 
              RowBox[{"\[ImaginaryI]", "+", "1"}], ")"}]}]},
           {
            RowBox[{"kx", "-", "\[Epsilon]"}], "0", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"ky", "-", "\[Epsilon]"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"1", "+", "\[ImaginaryI]"}], ")"}]}]},
           {
            RowBox[{"\[Epsilon]", 
             RowBox[{"(", 
              RowBox[{"\[ImaginaryI]", "-", "1"}], ")"}]}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"ky", "+", "\[Epsilon]"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"1", "-", "\[ImaginaryI]"}], ")"}]}], "\[Epsilon]"}
          },
          GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
          
          GridBoxSpacings->{"Columns" -> {
              Offset[0.27999999999999997`], {
               Offset[0.7]}, 
              Offset[0.27999999999999997`]}, "Rows" -> {
              Offset[0.2], {
               Offset[0.4]}, 
              Offset[0.2]}}], ")"}]}], ")"}], "-", 
      RowBox[{"en", " ", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dat1", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kx", ",", "ky", ",", 
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"ham", "[", 
              RowBox[{"kx", ",", "ky", ",", "0.1"}], "]"}], "]"}], "]"}], 
           "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"kx", ",", 
         RowBox[{"-", "0.15"}], ",", "0.15", ",", "0.005"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ky", ",", 
         RowBox[{"-", "0.5"}], ",", "0.5", ",", "0.05"}], "}"}]}], "]"}], ",",
      "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dat2", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kx", ",", "ky", ",", 
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"ham", "[", 
              RowBox[{"kx", ",", "ky", ",", "0.1"}], "]"}], "]"}], "]"}], 
           "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"kx", ",", 
         RowBox[{"-", "0.15"}], ",", "0.15", ",", "0.005"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ky", ",", 
         RowBox[{"-", "0.5"}], ",", "0.5", ",", "0.05"}], "}"}]}], "]"}], ",",
      "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dat3", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kx", ",", "ky", ",", 
         RowBox[{
          RowBox[{"Sort", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"ham", "[", 
              RowBox[{"kx", ",", "ky", ",", "0.1"}], "]"}], "]"}], "]"}], 
           "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"kx", ",", 
         RowBox[{"-", "0.15"}], ",", "0.15", ",", "0.005"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ky", ",", 
         RowBox[{"-", "0.5"}], ",", "0.5", ",", "0.05"}], "}"}]}], "]"}], ",",
      "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot3D", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dat1", ",", "dat2", ",", "dat3"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(k\), \(x\)]\)\>\"", 
      ",", "\"\<\!\(\*SubscriptBox[\(k\), \(y\)]\)\>\"", 
      ",", "\"\<Abs[E]\>\""}], "}"}]}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "Medium"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"SeriesCoefficient", "[", 
  RowBox[{
   RowBox[{"det", "[", 
    RowBox[{"kx", ",", "ky", ",", "\[Epsilon]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"en", ",", "0", ",", "3"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"A", "[", 
    RowBox[{"kx_", ",", "ky_", ",", "\[Epsilon]_"}], "]"}], "=", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{
     RowBox[{"det", "[", 
      RowBox[{"kx", ",", "ky", ",", "\[Epsilon]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"en", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", 
    RowBox[{"kx_", ",", "ky_", ",", "\[Epsilon]_"}], "]"}], "=", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{
     RowBox[{"det", "[", 
      RowBox[{"kx", ",", "ky", ",", "\[Epsilon]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"en", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CC", "[", 
    RowBox[{"kx_", ",", "ky_", ",", "\[Epsilon]_"}], "]"}], "=", 
   RowBox[{"SeriesCoefficient", "[", 
    RowBox[{
     RowBox[{"det", "[", 
      RowBox[{"kx", ",", "ky", ",", "\[Epsilon]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"en", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "[", 
    RowBox[{"kx_", ",", "ky_", ",", "\[Epsilon]_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"B", "[", 
      RowBox[{"kx", ",", "ky", ",", "\[Epsilon]"}], "]"}], "3"], "\[Minus]", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"A", "[", 
        RowBox[{"kx", ",", "ky", ",", "\[Epsilon]"}], "]"}], ")"}], "2"], 
     "9"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"q", "[", 
     RowBox[{"kx_", ",", "ky_", ",", "\[Epsilon]_"}], "]"}], "=", 
    RowBox[{
     RowBox[{"\[Minus]", 
      FractionBox[
       RowBox[{"CC", "[", 
        RowBox[{"kx", ",", "ky", ",", "\[Epsilon]"}], "]"}], "2"]}], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"kx", ",", "ky", ",", "\[Epsilon]"}], "]"}], " ", 
       RowBox[{"B", "[", 
        RowBox[{"kx", ",", "ky", ",", "\[Epsilon]"}], "]"}]}], "6"], "\[Minus]", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"A", "[", 
         RowBox[{"kx", ",", "ky", ",", "\[Epsilon]"}], "]"}], ")"}], "3"], 
      "27"]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
