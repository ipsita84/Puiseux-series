 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"omx", ",", " ", "omy", ",", " ", "omz"}], "]"}], ";", 
   RowBox[{
    RowBox[{"omx", "[", "i_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "1"}], "3"], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"j", "\[NotEqual]", "i"}], ",", 
         RowBox[{
          RowBox[{"(", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"vecdag", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ".", 
               RowBox[{"(", 
                RowBox[{"dery", ".", 
                 RowBox[{"vec", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"vecdag", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ".", 
               RowBox[{"(", 
                RowBox[{"derz", ".", 
                 RowBox[{"vec", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], ")"}]}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
