              RowBox[{"(", 
               RowBox[{
                RowBox[{"vecdag", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ".", 
                RowBox[{"(", 
                 RowBox[{"derz", ".", 
                  RowBox[{"vec", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ")"}], "*", 
