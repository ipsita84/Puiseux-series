 RowBox[{
  RowBox[{"hbar", "=", 
   RowBox[{
    RowBox[{"hini", "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kx", "->", 
        RowBox[{"a", " ", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
