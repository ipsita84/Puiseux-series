      RowBox[{"k", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", " ", 
     RowBox[{
      SuperscriptBox["\[Xi]", "2"], "->", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ass", "=", 
