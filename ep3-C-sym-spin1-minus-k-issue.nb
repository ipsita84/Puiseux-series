             Offset[0.2], {
              Offset[0.4]}, 
             Offset[0.2]}}], "\[NoBreak]", ")"}],
       Function[BoxForm`e$, 
        MatrixForm[BoxForm`e$]]],
      Function[BoxForm`e$, 
       MatrixForm[BoxForm`e$]]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Conjugate", "[", "cmat", "]"}], ".", "cmat"}], "//", 
      "MatrixForm"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", "cmat", "]"}], ".", "cmat"}], "//", 
      "MatrixForm"}]}], "}"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"hamt", "[", 
      RowBox[{"kx_", ",", "ky_", ",", "kz_", ",", "a_"}], "]"}], "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"ham", "[", 
       RowBox[{"kx", ",", "ky", ",", "kz", ",", "a"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
