                 RowBox[{"dery", ".", 
                  RowBox[{"vec", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], ")"}]}]}], 
            ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
