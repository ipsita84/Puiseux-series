Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Eigenvalues", "[", 
   RowBox[{"hini", "=", 
    TagBox[
     RowBox[{"(", "\[NoBreak]", GridBox[{
        {"0", 
         RowBox[{"kx", "-", 
          RowBox[{"\[ImaginaryI]", " ", "ky"}]}], 
         RowBox[{
          RowBox[{"\[ImaginaryI]", " ", "a"}], "-", 
          RowBox[{"\[ImaginaryI]", " ", "kz"}]}]},
        {
         RowBox[{"kx", "+", 
          RowBox[{"\[ImaginaryI]", " ", "ky"}]}], "0", "0"},
        {
         RowBox[{
          RowBox[{"\[ImaginaryI]", " ", "a"}], "+", 
          RowBox[{"\[ImaginaryI]", " ", "kz"}]}], "0", "0"}
       },
       GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.7]}, 
