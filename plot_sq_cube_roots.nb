Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"p", "[", 
  RowBox[{"kx", ",", "ky", ",", "\[Epsilon]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q", "[", 
   RowBox[{"kx", ",", "ky", ",", "\[Epsilon]"}], "]"}], "//", 
  "FullSimplify"}]}], "Input",
 CellChangeTimes->{{3.827323712758317*^9, 3.827323762595351*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"a1f347ac-e75d-4bfb-a606-4b508a09b7a1"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "3"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["kx", "2"]}], "-", 
    RowBox[{"2", " ", 
     SuperscriptBox["ky", "2"]}], "+", 
    RowBox[{"4", " ", 
     SuperscriptBox["\[Epsilon]", "2"]}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.827323730062993*^9, 3.827323762971818*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"0353eaa8-2231-48e6-8ba5-f90b95231e2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", "2"]}], " ", "\[Epsilon]", " ", 
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["kx", "2"], "-", 
    RowBox[{"2", " ", 
     SuperscriptBox["ky", "2"]}], "-", 
    RowBox[{"4", " ", "kx", " ", "\[Epsilon]"}], "+", 
    RowBox[{"4", " ", "ky", " ", "\[Epsilon]"}], "+", 
    SuperscriptBox["\[Epsilon]", "2"]}], ")"}]}]], "Output",
 CellChangeTimes->{3.827323730062993*^9, 3.827323762988058*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"22d51962-d3a3-4a83-b6e7-6756b37edcbe"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"eq1", ",", "eq2", ",", "nsol"}], "]"}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"q", "+", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["q", "2"], "+", 
      SuperscriptBox["p", "3"]}]]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"kx", ",", "ky", ",", "0.1"}], "]"}], "//", "TrigToExp"}], 
      ")"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kx", "\[Rule]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{"Log", "[", "ux", "]"}]}]}], ",", 
       RowBox[{"ky", "\[Rule]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{"Log", "[", "uy", "]"}]}]}]}], "}"}]}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"kx", ",", "ky", ",", "0.1"}], "]"}], "//", "TrigToExp"}], 
      ")"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kx", "\[Rule]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{"Log", "[", "ux", "]"}]}]}], ",", 
       RowBox[{"ky", "\[Rule]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{"Log", "[", "uy", "]"}]}]}]}], "}"}]}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nsol", "=", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"eq1", "\[Equal]", "0"}], " ", "&&", " ", 
       RowBox[{"eq2", "\[Equal]", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ux", ",", "uy"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", 
    RowBox[{"Length", "[", "nsol", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", 
   RowBox[{"Print", "[", 
    RowBox[{"i", ",", "\"\< kx= \>\"", ",", 
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"Log", "[", "ux", "]"}]}], "/.", 
